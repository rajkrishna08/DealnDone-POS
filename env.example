# Azure AD Configuration
AZURE_AD_TENANT_ID=your-tenant-id-here
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here

# Cosmos DB Configuration
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key-here
COSMOS_DATABASE=dealndone2025

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here

# Currency API
CURRENCY_API_KEY=your-currency-api-key-here

# Database Configuration
DATABASE_URL=sqlite:///dealndone.db

# Application Configuration
APP_NAME=DealNDone 2025
APP_VERSION=1.0.0
ENVIRONMENT=development

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# Monitoring Configuration
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-here

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Payment Gateway Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

# Azure Container Registry
REGISTRY_LOGIN_SERVER=your-registry.azurecr.io
REGISTRY_USERNAME=your-registry-username
REGISTRY_PASSWORD=your-registry-password 